# Telegram bot used for HMAC validation of WebApp initData.
# Same value as TELEGRAM_TOKEN in the bot's .env.
TELEGRAM_BOT_TOKEN=
# Bot's username without the leading "@". Used to build deep links and
# referral links (https://t.me/<username>?start=...).
TELEGRAM_BOT_USERNAME=

# Remnawave panel — same values as the bot's .env.
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_TOKEN=

# Tariffs (RUB and Telegram Stars). Match the bot's .env.
PRICE_1=100
PRICE_3=289
PRICE_6=550
PRICE_12=1020
STARS_PRICE_1=75
STARS_PRICE_3=220
STARS_PRICE_6=425
STARS_PRICE_12=785

DAYS_IN_MONTH=30
REFERRAL_DAYS=7

# Comma-separated list of allowed CORS origins (the URL where the mini-app
# frontend is hosted, e.g. https://vpn-shop-miniapp.vercel.app). Use "*" only
# in development.
CORS_ORIGINS=*

# Postgres DSN for the bot's database (same as the bot's own DATABASE_URL).
# Optional. When set:
#   - /api/referral returns real invited/bonus counts
#   - /api/invoice with method=stars creates a real Telegram Stars invoice
#     that the mini-app opens via WebApp.openInvoice (no leaving the app)
# When unset, both endpoints work but with placeholders / deep-link redirects
# back to the bot.
DATABASE_URL=

# WARNING: dev only. If true, requests without X-Telegram-Init-Data header
# are accepted and a fake user (id=0) is used. Never enable in production.
ALLOW_UNSIGNED_DEV=false
